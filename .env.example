# Optional Docker settings. Defaults preserve the browser's localhost:3000 origin.
ARCHIGEN_WEB_PORT=3000
ARCHIGEN_API_PORT=8000
ARCHIGEN_MLFLOW_PORT=5000
ARCHIGEN_FURNITURE_DETAIL=high
ARCHIGEN_MLFLOW_ENABLED=1
ARCHIGEN_FACADE_EXPERIMENT=
# Paths are relative to the Compose project unless absolute.
ARCHIGEN_MLFLOW_DB=./mlflow.db
ARCHIGEN_MLFLOW_ARTIFACTS=./mlartifacts
